CREATE TABLE Post (
    id              TEXT PRIMARY KEY NOT NULL,
    text            TEXT NOT NULL DEFAULT '',
    photos_json     TEXT NOT NULL DEFAULT '[]',
    recipe_id       TEXT,
    rating          INTEGER NOT NULL DEFAULT 0,
    user_reaction   TEXT,
    comments_count  INTEGER NOT NULL DEFAULT 0,
    author_id       TEXT NOT NULL,
    author_name     TEXT NOT NULL,
    author_image_id TEXT,
    created_at      TEXT NOT NULL,
    updated_at      TEXT NOT NULL
);

CREATE INDEX Post_created_at ON Post(created_at DESC);

insertPost:
INSERT OR REPLACE INTO Post(
    id, text, photos_json, recipe_id, rating, user_reaction, comments_count,
    author_id, author_name, author_image_id, created_at, updated_at
) VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllPosts:
SELECT * FROM Post
ORDER BY created_at DESC
LIMIT ? OFFSET ?;

countAllPosts:
SELECT COUNT(*) FROM Post;

getPostById:
SELECT * FROM Post WHERE id = ?;

clearAllPosts:
DELETE FROM Post;

applyVote:
UPDATE Post
SET rating = ?, user_reaction = ?
WHERE id = ?;

deletePost:
DELETE FROM Post WHERE id = ?;
